{
	"name": "dsh-grantwrite-patch",
	"version": "0.1.0",
	"description": "Windows sandbox ACL-repair plugin for DeepSeek Harness (dsh) — fix the grantWrite failure (SetNamedSecurityInfoW Win32 5) and retry the command invisibly",
	"keywords": [
		"acl",
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"windows-sandbox"
	],
	"homepage": "https://github.com/0-v-0/dsh-grantwrite-patch#readme",
	"bugs": {
		"url": "https://github.com/0-v-0/dsh-grantwrite-patch/issues"
	},
	"license": "MIT",
	"author": "0-v-0 <kduice@qq.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0-v-0/dsh-grantwrite-patch.git"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.zh.md"
	],
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./preload": "./lib/preload.cjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "oxlint",
		"pretest": "pnpm build",
		"prepublishOnly": "pnpm test",
		"test": "node test/apply.test.ts && node test/index.test.ts && node test/strategy.test.ts && node test/size-probe.test.ts",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^7.0.2"
	},
	"engines": {
		"dsh": ">=0.1.7-rc.1",
		"node": ">=22.18"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	}
}
