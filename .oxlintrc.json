{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["import", "unicorn", "oxc"],
	"categories": {
		"correctness": "off"
	},
	"options": {
		"reportUnusedDisableDirectives": "warn",
		"typeAware": true
	},
	"env": {
		"builtin": true
	},
	"rules": {
		"no-negated-condition": "warn",
		// ── Conflict-minimizing rules ──
		// Import section: dedup + consistent boundary + consistent type-specifier
		// style. (sort-imports is skipped — oxfmt sortImports already handles
		// import ordering; a lint rule would fight the formatter.)
		"import/no-duplicates": ["warn", { "preferInline": true }],
		"import/newline-after-import": "warn",
		"import/consistent-type-specifier-style": ["warn", "prefer-top-level-if-only-type-imports"],
		// One item per line: a declaration or statement that packs several items
		// forces every edit onto a shared line, which is exactly what turns two
		// parallel edits into a conflict instead of two independent added lines.
		"one-var": ["warn", "never"],
		"no-multi-assign": "warn",
		"no-sequences": "warn",
		// Structural consistency: consistent braces / syntax = less churn when
		// adding statements, fewer reformatting diffs across branches.
		"curly": "warn",
		"no-useless-computed-key": "warn",
		"object-shorthand": "warn",
		"prefer-template": "warn",
		"prefer-object-spread": "warn",
		"sort-keys": "warn",
		"unicorn/switch-case-braces": "warn",
		"unicorn/no-nested-ternary": "warn",
		"unicorn/consistent-template-literal-escape": "warn",
		// Canonical branch shape: when there is exactly one idiomatic way to
		// write a branch, two people extending the same if/switch produce the
		// same shape, and the merge stays a textual one.
		"no-else-return": "warn",
		"no-unneeded-ternary": "warn",
		"operator-assignment": "warn",
		// Object-only: array destructuring is often positional and rewriting it
		// would reorder lines, which is churn we do not want.
		"prefer-destructuring": [
			"warn",
			{
				"VariableDeclarator": { "object": true, "array": false },
				"AssignmentExpression": { "object": true, "array": false }
			}
		],
		// Deterministic append points: default/optional members must sit last,
		// so adding a case or a param appends a line instead of shifting the
		// neighbors that another branch is editing.
		"default-case-last": "warn",
		"default-param-last": "warn",
		"no-case-declarations": "warn",
		"import/first": "warn",
		"vars-on-top": "warn",
		// Size limits: conflicts are a function of how many people touch the
		// same region, so keep units small enough to be owned by one change.
		// Warn-only nudges toward splitting, not CI gates.
		"max-lines": ["warn", { "max": 400, "skipBlankLines": true, "skipComments": true }],
		"max-lines-per-function": [
			"warn",
			{ "max": 80, "skipBlankLines": true, "skipComments": true }
		],
		"max-depth": ["warn", { "max": 4 }],
		"max-params": ["warn", { "max": 5 }],
		"complexity": ["warn", { "max": 15 }],
		"max-classes-per-file": ["warn", 1],
		// Coupling: a file that imports half the repo is a file everyone edits.
		"import/max-dependencies": ["warn", { "max": 15 }],
		// Stable export surface. group-exports is deliberately NOT enabled —
		// funnelling every export into one statement creates a hotspot line
		// that every branch has to edit, which is the opposite of the goal.
		"import/no-mutable-exports": "warn",
		"unicorn/prefer-export-from": "warn",
		// File identity: one convention means one name per file, so two branches
		// cannot land `fooBar.ts` and `foo-bar.ts` side by side, and renames
		// (the change git merges worst) stop being a matter of taste. Verified:
		// multi-part extensions (`.test.ts`, `.d.ts`), leading underscore and
		// leading digits all still pass. Exceptions go into `ignore` as regexes
		// — note they must not contain backslash escapes, oxlint's config
		// parser rejects them (invalid escape), so match on prefixes instead.
		"unicorn/filename-case": ["warn", { "case": "kebabCase" }],
		// ── Performance rules ──
		"no-await-in-loop": "warn",
		"no-useless-call": "warn",
		"no-accumulating-spread": "warn",
		"no-map-spread": "warn",
		"prefer-array-find": "warn",
		"prefer-array-flat-map": "warn",
		"prefer-set-has": "warn",
		// These two tsgolint rules require type-aware checking with
		// strictNullChecks (tsconfig.json: strictNullChecks: true, strict:
		// false). They are off at the top level (applies outside the type-aware
		// src override) and re-enabled as error in the src override below for
		// the plugin source.
		"typescript/no-unnecessary-boolean-literal-compare": "off",
		"typescript/no-useless-default-assignment": "off"
	},
	"ignorePatterns": [
		"**/lib/**",
		"**/node_modules/**",
		"**/.dsh-smoke/**",
		"**/dist/**",
		"**/docs/**",
		"**/profiles/**",
		"**/*.js",
		"**/*.mjs",
		"**/*.cjs",
		"**/*.config.ts"
	],
	"overrides": [
		{
			// Shared strict type-aware rules. Synced from deepseek-harness@master
			// .oxlintrc.json (first override), adapted to this repository's layout:
			// the plugin TypeScript source lives in src (lib is build
			// output, and the session-tools skill is plain JS excluded from the
			// type-aware ruleset via the global *.js ignore).
			"files": ["src/**/*.{ts,tsx}"],
			"plugins": ["typescript"],
			"rules": {
				"no-var": "error",
				"prefer-const": "error",
				"prefer-rest-params": "error",
				"prefer-spread": "error",
				"no-array-constructor": "error",
				"no-unused-expressions": "error",
				"no-unused-vars": [
					"error",
					{
						"argsIgnorePattern": "^_",
						"varsIgnorePattern": "^_",
						"caughtErrorsIgnorePattern": "^_"
					}
				],
				"no-useless-constructor": "error",
				"typescript/await-thenable": "error",
				"typescript/ban-ts-comment": [
					"error",
					{
						"minimumDescriptionLength": 10
					}
				],
				"typescript/no-array-delete": "error",
				"typescript/no-base-to-string": "error",
				"typescript/no-confusing-void-expression": "error",
				"typescript/no-deprecated": "error",
				"typescript/no-duplicate-enum-values": "error",
				"typescript/no-duplicate-type-constituents": "error",
				"typescript/no-dynamic-delete": "error",
				"typescript/no-empty-object-type": "off",
				"typescript/no-explicit-any": "error",
				"typescript/no-extra-non-null-assertion": "error",
				"typescript/no-extraneous-class": "error",
				"typescript/no-floating-promises": "error",
				"typescript/no-for-in-array": "error",
				"typescript/no-implied-eval": "error",
				"typescript/no-invalid-void-type": "off",
				"typescript/no-meaningless-void-operator": "error",
				"typescript/no-misused-new": "error",
				"typescript/no-misused-promises": "error",
				"typescript/no-misused-spread": "error",
				"typescript/no-mixed-enums": "error",
				"typescript/no-namespace": "off",
				"typescript/no-non-null-asserted-nullish-coalescing": "error",
				"typescript/no-non-null-asserted-optional-chain": "error",
				"typescript/no-redundant-type-constituents": "error",
				"typescript/no-require-imports": "error",
				"typescript/no-this-alias": "error",
				"typescript/no-unnecessary-boolean-literal-compare": "error",
				"typescript/no-unnecessary-template-expression": "error",
				"typescript/no-unnecessary-type-arguments": "error",
				"typescript/no-unnecessary-type-assertion": "error",
				"typescript/no-unnecessary-type-constraint": "error",
				"typescript/no-unnecessary-type-conversion": "error",
				"typescript/no-unnecessary-type-parameters": "error",
				"typescript/no-unsafe-argument": "error",
				"typescript/no-unsafe-assignment": "error",
				"typescript/no-unsafe-call": "error",
				"typescript/no-unsafe-declaration-merging": "error",
				"typescript/no-unsafe-enum-comparison": "error",
				"typescript/no-unsafe-function-type": "error",
				"typescript/no-unsafe-member-access": "error",
				"typescript/no-unsafe-return": "error",
				"typescript/no-unsafe-unary-minus": "error",
				"typescript/no-useless-default-assignment": "error",
				"typescript/no-wrapper-object-types": "error",
				"typescript/prefer-as-const": "error",
				"typescript/prefer-literal-enum-member": "error",
				"typescript/prefer-namespace-keyword": "error",
				"typescript/prefer-promise-reject-errors": "error",
				"typescript/prefer-reduce-type-parameter": "error",
				"typescript/prefer-return-this-type": "error",
				"typescript/related-getter-setter-pairs": "error",
				"typescript/restrict-plus-operands": [
					"error",
					{
						"allowAny": false,
						"allowBoolean": false,
						"allowNullish": false,
						"allowNumberAndString": false,
						"allowRegExp": false
					}
				],
				"typescript/return-await": ["error", "error-handling-correctness-only"],
				"typescript/triple-slash-reference": "error",
				"typescript/unbound-method": "error",
				"typescript/unified-signatures": "error",
				"typescript/use-unknown-in-catch-callback-variable": "error",
				"no-void": "off"
			}
		},
		{
			// DSH plugin API boundary, deliberately wider than the upstream default.
			// The plugin surface is `any`-typed on purpose: the Cordis/DSH plugin
			// event payloads are polymorphic and ctx/bot handles come from ambient
			// declarations (types/plugin.d.ts) with the compiler loosened
			// accordingly (strict: false, noImplicitAny: false). Enforcing
			// no-explicit-any / no-unsafe-* here would force re-typing the whole
			// DSH event contract, so this repo deviates from the upstream ruleset
			// exactly on those boundary rules and keeps everything else strict.
			"files": ["src/**/*.{ts,tsx}"],
			"plugins": ["typescript"],
			"rules": {
				"typescript/no-explicit-any": "off",
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-declaration-merging": "off",
				"typescript/no-unsafe-enum-comparison": "off",
				"typescript/no-unsafe-function-type": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off",
				"typescript/no-unsafe-unary-minus": "off"
			}
		},
		{
			// Type-level spelling consistency. The same type written two ways
			// (`T[]` vs `Array<T>`, `interface` vs `type`, `Record<K, V>` vs
			// `{ [k: K]: V }`, `{ (): void }` vs `() => void`) is a purely
			// cosmetic diff that still collides with real changes on merge,
			// and it silently spreads via copy-paste.
			"files": ["src/**/*.{ts,tsx}"],
			"plugins": ["typescript"],
			"rules": {
				"typescript/array-type": ["warn", { "default": "array-simple" }],
				"typescript/consistent-type-definitions": ["warn", "interface"],
				"typescript/consistent-indexed-object-style": ["warn", "record"],
				"typescript/consistent-type-assertions": ["warn", { "assertionStyle": "as" }],
				"typescript/prefer-function-type": "warn",
				// Overloads that drift apart are edited in two places; keeping
				// them adjacent keeps the change single-hunk.
				"typescript/adjacent-overload-signatures": "warn"
			}
		},
		{
			// Size limits are nudges for source, not for tests: specs are
			// legitimately long (fixtures, per-case describes) and splitting
			// them on line count would only add churn.
			"files": ["**/*.{test,spec}.{ts,tsx}", "**/__tests__/**/*.{ts,tsx}"],
			"rules": {
				"max-lines": "off",
				"max-lines-per-function": "off",
				"max-statements": "off",
				"max-depth": "off",
				"complexity": "off",
				"max-classes-per-file": "off"
			}
		}
	]
}
