{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["import", "unicorn", "oxc", "typescript"],
	"categories": {
		"correctness": "off"
	},
	// JS plugins are currently in alpha (oxlint >= 1.57); the API is
	// compatible with ESLint v9+. The plugin name "unicorn" of
	// eslint-plugin-unicorn collides with the built-in Rust unicorn plugin
	// (reserved-name error), so it is loaded under the alias unicorn-js.
	"jsPlugins": [
		{ "name": "unicorn-js", "specifier": "eslint-plugin-unicorn" },
		// sonarjs: deterministic code-quality rules (traditional visitor
		// pattern; rules using context.on were excluded as they don't fire
		// under oxlint). Only rules verified to fire are included.
		{ "name": "sonarjs", "specifier": "eslint-plugin-sonarjs" },
		// regexp: deterministic regex lint (traditional visitor pattern, no
		// context.on). Only rules verified to fire are included.
		{ "name": "regexp", "specifier": "eslint-plugin-regexp" },
		// n: Node.js-specific rules (traditional visitor pattern). Only
		// handle-callback-err fires under oxlint (verified).
		{ "name": "n", "specifier": "eslint-plugin-n" },
		// Custom rule: require template literals only for chained string
		// concatenation (2+ `+`), exempting single-`+` joins
		{ "name": "prefer-template-multi", "specifier": "./scripts/oxlint-plugins/prefer-template-multi.ts" }
	],
	"options": {
		"reportUnusedDisableDirectives": "warn",
		"typeAware": true
	},
	"env": {
		"builtin": true
	},
	"rules": {
		"no-negated-condition": "warn",
		// ── Conflict-minimizing rules ──
		// Import section: dedup + consistent boundary + consistent type-specifier
		// style. (sort-imports is skipped — oxfmt sortImports already handles
		// import ordering; a lint rule would fight the formatter.)
		"import/no-duplicates": ["warn", { "preferInline": true }],
		"import/newline-after-import": "warn",
		"import/consistent-type-specifier-style": ["warn", "prefer-top-level-if-only-type-imports"],
		// One item per line: a declaration or statement that packs several items
		// forces every edit onto a shared line, which is exactly what turns two
		// parallel edits into a conflict instead of two independent added lines.
		"one-var": ["warn", "never"],
		"no-multi-assign": "warn",
		"no-sequences": "warn",
		// Structural consistency: consistent braces / syntax = less churn when
		// adding statements, fewer reformatting diffs across branches.
		"curly": "warn",
		"no-useless-computed-key": "warn",
		"object-shorthand": "warn",
		"prefer-object-spread": "warn",
		"sort-keys": "warn",
		"unicorn/switch-case-braces": ["warn", "avoid"],
		"unicorn/no-nested-ternary": "warn",
		"unicorn/consistent-template-literal-escape": "warn",
		// see scripts/oxlint-plugins/prefer-template-multi.ts.
		"prefer-template-multi/prefer-template": "warn",
		// Canonical branch shape: when there is exactly one idiomatic way to
		// write a branch, two people extending the same if/switch produce the
		// same shape, and the merge stays a textual one.
		"unicorn-js/no-useless-else": "warn",
		"no-unneeded-ternary": "warn",
		"operator-assignment": "warn",
		// Object-only: array destructuring is often positional and rewriting it
		// would reorder lines, which is churn we do not want.
		"prefer-destructuring": [
			"warn",
			{
				"VariableDeclarator": { "object": true, "array": false },
				"AssignmentExpression": { "object": true, "array": false }
			}
		],
		// Deterministic append points: default/optional members must sit last,
		// so adding a case or a param appends a line instead of shifting the
		// neighbors that another branch is editing.
		"default-case-last": "warn",
		"default-param-last": "warn",
		"no-case-declarations": "warn",
		"import/first": "warn",
		"vars-on-top": "warn",
		// Size limits: conflicts are a function of how many people touch the
		// same region, so keep units small enough to be owned by one change.
		// Warn-only nudges toward splitting, not CI gates.
		"max-lines": ["warn", { "max": 500, "skipBlankLines": true, "skipComments": true }],
		"max-lines-per-function": ["warn", { "max": 80, "skipBlankLines": true, "skipComments": true }],
		"max-depth": ["warn", { "max": 4 }],
		"max-params": ["warn", { "max": 5 }],
		"complexity": ["warn", { "max": 20 }],
		"max-classes-per-file": ["warn", 1],
		// Coupling: a file that imports half the repo is a file everyone edits.
		"import/max-dependencies": ["warn", { "max": 15 }],
		// Stable export surface. group-exports is deliberately NOT enabled —
		// funnelling every export into one statement creates a hotspot line
		// that every branch has to edit, which is the opposite of the goal.
		"import/no-mutable-exports": "warn",
		"unicorn/prefer-export-from": "warn",
		"unicorn/error-message": "warn",
		"unicorn/new-for-builtins": "warn",
		"unicorn/no-this-assignment": "warn",
		"unicorn/prefer-includes": "warn",
		"unicorn/prefer-node-protocol": "warn",
		"unicorn/prefer-type-error": "warn",
		"unicorn/catch-error-name": ["warn", { "name": "e" }],
		// File identity: one convention means one name per file, so two branches
		// cannot land `fooBar.ts` and `foo-bar.ts` side by side, and renames
		// (the change git merges worst) stop being a matter of taste. Verified:
		// multi-part extensions (`.test.ts`, `.d.ts`), leading underscore and
		// leading digits all still pass. Exceptions go into `ignore` as regexes
		// — note they must not contain backslash escapes, oxlint's config
		// parser rejects them (invalid escape), so match on prefixes instead.
		"unicorn/filename-case": ["warn", { "case": "kebabCase" }],
		// ── Performance rules ──
		"no-await-in-loop": "warn",
		"no-useless-call": "warn",
		"no-accumulating-spread": "warn",
		"no-map-spread": "warn",
		"prefer-array-find": "warn",
		"prefer-array-flat-map": "warn",
		"prefer-set-has": "warn",
		// These two tsgolint rules require type-aware checking with
		// strictNullChecks (tsconfig.json: strictNullChecks: true, strict:
		// false). Warn at the top level (applies to the whole repo), re-enabled
		// as error in the src override below for the plugin source.
		"typescript/no-unnecessary-boolean-literal-compare": "warn",
		"typescript/no-useless-default-assignment": "warn",
		// ── Type-aware rules ──
		// Deterministic checks backed by the type checker (low false-positive
		// rate) that also shrink diffs: they remove redundant code instead of
		// restyling it. Warn-only repo-wide; the src override keeps them at
		// error for the plugin source.
		"typescript/await-thenable": "warn",
		"typescript/no-base-to-string": "warn",
		"typescript/no-confusing-void-expression": "warn",
		"typescript/no-floating-promises": "warn",
		"typescript/no-for-in-array": "warn",
		"typescript/no-meaningless-void-operator": "warn",
		"typescript/no-misused-promises": "warn",
		"typescript/no-misused-spread": "warn",
		"typescript/no-this-alias": "warn",
		"typescript/no-unnecessary-template-expression": "warn",
		"typescript/no-unnecessary-type-arguments": "warn",
		"typescript/no-unnecessary-type-assertion": "warn",
		"typescript/no-unnecessary-type-constraint": "warn",
		"typescript/no-unnecessary-type-conversion": "warn",
		"typescript/no-unnecessary-type-parameters": "warn",
		"typescript/prefer-return-this-type": "warn",
		"typescript/return-await": ["warn", "error-handling-correctness-only"],
		"typescript/unbound-method": "warn",
		// ── Unicorn JS-plugin rules (via unicorn-js alias) ──
		// Subset of eslint-plugin-unicorn not yet implemented natively in oxlint,
		// selected for: deterministic detection (few false positives), no DOM/Node
		// environment requirements, no type-aware analysis, and a canonical output
		// shape that keeps merge conflicts low. All warn-only like the rest of the
		// conflict-minimizing set.
		"unicorn-js/logical-assignment-operators": "warn",
		"unicorn-js/no-chained-comparison": "warn",
		"unicorn-js/no-duplicate-if-branches": "warn",
		"unicorn-js/no-duplicate-logical-operands": "warn",
		"unicorn-js/no-duplicate-set-values": "warn",
		"unicorn-js/no-impossible-length-comparison": "warn",
		"unicorn-js/no-misrefactored-assignment": "warn",
		"unicorn-js/no-named-default": "warn",
		"unicorn-js/no-negated-array-predicate": "warn",
		"unicorn-js/no-redundant-comparison": "warn",
		"unicorn-js/no-return-array-push": "warn",
		"unicorn-js/no-subtraction-comparison": "warn",
		"unicorn-js/no-unnecessary-array-flat-map": "warn",
		"unicorn-js/no-unnecessary-boolean-comparison": "warn",
		"unicorn-js/no-unnecessary-splice": "warn",
		"unicorn-js/no-useless-boolean-cast": "warn",
		"unicorn-js/no-useless-coercion": "warn",
		"unicorn-js/no-useless-compound-assignment": "warn",
		"unicorn-js/no-useless-concat": "warn",
		"unicorn-js/no-useless-continue": "warn",
		"unicorn-js/no-useless-delete-check": "warn",
		"unicorn-js/no-useless-logical-operand": "warn",
		"unicorn-js/no-useless-override": "warn",
		"unicorn-js/no-useless-recursion": "warn",
		"unicorn-js/prefer-array-from-map": "warn",
		"unicorn-js/prefer-array-some": "warn",
		"unicorn-js/prefer-combined-guards": "warn",
		"unicorn-js/prefer-simple-sort-comparator": "warn",
		"unicorn-js/prefer-type-literal-last": "warn",
		"unicorn/prefer-array-index-of": "warn",
		// ── New-project rules (greenfield baseline; no migration cost) ──
		"unicorn-js/prefer-early-return": "warn",
		"unicorn-js/prefer-while-loop-condition": "warn",
		"unicorn-js/no-duplicate-loops": "warn",
		"unicorn-js/no-lonely-if": "warn",
		"unicorn-js/prefer-logical-operator-over-ternary": "warn",
		"unicorn-js/no-array-sort-for-min-max": "warn",
		"unicorn-js/prefer-array-iterable-methods": "warn",
		"unicorn-js/prefer-array-last-methods": "warn",
		"unicorn-js/prefer-string-replace-all": "warn",
		// ── eslint-config-simplesense subset (JS-plugin rules) ──
		// General-purpose: deterministic detection, no DOM/Node env, low false
		// positives. Rules from simplesense's unicorn set not in oxlint's
		// built-in Rust unicorn.
		"unicorn-js/no-accessor-recursion": "warn",
		"unicorn-js/no-array-method-this-argument": "warn",
		"unicorn-js/no-new-array": "warn",
		"unicorn-js/no-new-buffer": "warn",
		"unicorn-js/no-single-promise-in-promise-methods": "warn",
		"unicorn-js/no-typeof-undefined": "warn",
		"unicorn-js/no-unnecessary-slice-end": "warn",
		"unicorn-js/no-useless-promise-resolve-reject": "warn",
		"unicorn-js/prefer-date-now": "warn",
		"unicorn-js/prefer-number-properties": "warn",
		"unicorn-js/prefer-regexp-test": "warn",
		"unicorn-js/prefer-string-slice": "warn",
		"unicorn-js/prefer-string-starts-ends-with": "warn",
		"unicorn-js/prefer-string-trim-start-end": "warn",
		"unicorn-js/require-number-to-fixed-digits-argument": "warn",
		// ── eslint-config-simplesense subset (sonarjs + regexp) ──
		// General-purpose: deterministic code-quality rules that catch bugs
		// (duplicate branches, identical conditions, element overwrite, etc.).
		"sonarjs/no-collapsible-if": "warn",
		"sonarjs/no-collection-size-mischeck": "warn",
		"sonarjs/no-duplicated-branches": "warn",
		"sonarjs/no-element-overwrite": "warn",
		"sonarjs/no-extra-arguments": "warn",
		"sonarjs/no-gratuitous-expressions": "warn",
		"sonarjs/no-identical-conditions": "warn",
		"sonarjs/no-identical-expressions": "warn",
		"sonarjs/no-nested-switch": "warn",
		"sonarjs/no-redundant-jump": "warn",
		"sonarjs/no-small-switch": "warn",
		"sonarjs/no-useless-catch": "warn",
		"sonarjs/prefer-immediate-return": "warn",
		"sonarjs/prefer-while": "warn",
		// These need explicit options (oxlint passes no defaults).
		"sonarjs/max-switch-cases": ["warn", 30],
		"sonarjs/no-identical-functions": ["warn", 3],
		// regexp: deterministic regex bugs (duplicate chars, useless
		// quantifiers, suboptimal patterns). All verified to fire.
		"regexp/no-dupe-characters-character-class": "warn",
		"regexp/no-dupe-disjunctions": "warn",
		"regexp/no-empty-alternative": "warn",
		"regexp/no-useless-quantifier": "warn",
		"regexp/optimal-quantifier-concatenation": "warn",
		"regexp/prefer-character-class": "warn",
		"regexp/prefer-d": "warn",
		"regexp/prefer-quantifier": "warn",
		// ── eslint-config-simplesense subset (n plugin) ──
		// Only handle-callback-err fires under oxlint (verified).
		"n/handle-callback-err": "warn"
	},
	"ignorePatterns": [
		"**/lib/**",
		"**/node_modules/**",
		"**/.dsh-smoke/**",
		"**/dist/**",
		"**/docs/**",
		"**/profiles/**",
		"**/*.js",
		"**/*.mjs",
		"**/*.cjs",
		"**/*.config.ts"
	],
	"overrides": [
		{
			// Shared strict type-aware rules. Synced from deepseek-harness@master
			// .oxlintrc.json (first override), adapted to this repository's layout:
			// the plugin TypeScript source lives in src (lib is build
			// output, and the session-tools skill is plain JS excluded from the
			// type-aware ruleset via the global *.js ignore).
			"files": ["src/**/*.{ts,tsx}"],
			"plugins": ["typescript"],
			"rules": {
				"no-var": "error",
				"prefer-const": "error",
				"prefer-rest-params": "error",
				"prefer-spread": "error",
				"no-array-constructor": "error",
				"no-unused-expressions": "error",
				"no-unused-vars": [
					"error",
					{
						"argsIgnorePattern": "^_",
						"varsIgnorePattern": "^_",
						"caughtErrorsIgnorePattern": "^_"
					}
				],
				"no-useless-constructor": "error",
				"typescript/await-thenable": "error",
				"typescript/ban-ts-comment": [
					"error",
					{
						"minimumDescriptionLength": 10
					}
				],
				"typescript/no-array-delete": "error",
				"typescript/no-base-to-string": "error",
				"typescript/no-confusing-void-expression": "error",
				"typescript/no-deprecated": "error",
				"typescript/no-duplicate-enum-values": "error",
				"typescript/no-duplicate-type-constituents": "error",
				"typescript/no-dynamic-delete": "error",
				"typescript/no-empty-object-type": "off",
				"typescript/no-explicit-any": "error",
				"typescript/no-extra-non-null-assertion": "error",
				"typescript/no-extraneous-class": "error",
				"typescript/no-floating-promises": "error",
				"typescript/no-for-in-array": "error",
				"typescript/no-implied-eval": "error",
				"typescript/no-invalid-void-type": "off",
				"typescript/no-meaningless-void-operator": "error",
				"typescript/no-misused-new": "error",
				"typescript/no-misused-promises": "error",
				"typescript/no-misused-spread": "error",
				"typescript/no-mixed-enums": "error",
				"typescript/no-namespace": "off",
				"typescript/no-non-null-asserted-nullish-coalescing": "error",
				"typescript/no-non-null-asserted-optional-chain": "error",
				"typescript/no-redundant-type-constituents": "error",
				"typescript/no-require-imports": "error",
				"typescript/no-this-alias": "error",
				"typescript/no-unnecessary-boolean-literal-compare": "error",
				"typescript/no-unnecessary-template-expression": "error",
				"typescript/no-unnecessary-type-arguments": "error",
				"typescript/no-unnecessary-type-assertion": "error",
				"typescript/no-unnecessary-type-constraint": "error",
				"typescript/no-unnecessary-type-conversion": "error",
				"typescript/no-unnecessary-type-parameters": "error",
				"typescript/no-unsafe-argument": "error",
				"typescript/no-unsafe-assignment": "error",
				"typescript/no-unsafe-call": "error",
				"typescript/no-unsafe-declaration-merging": "error",
				"typescript/no-unsafe-enum-comparison": "error",
				"typescript/no-unsafe-function-type": "error",
				"typescript/no-unsafe-member-access": "error",
				"typescript/no-unsafe-return": "error",
				"typescript/no-unsafe-unary-minus": "error",
				"typescript/no-useless-default-assignment": "error",
				"typescript/no-wrapper-object-types": "error",
				"typescript/prefer-as-const": "error",
				"typescript/prefer-literal-enum-member": "error",
				"typescript/prefer-namespace-keyword": "error",
				"typescript/prefer-promise-reject-errors": "error",
				"typescript/prefer-reduce-type-parameter": "error",
				"typescript/prefer-return-this-type": "error",
				"typescript/related-getter-setter-pairs": "error",
				"typescript/restrict-plus-operands": [
					"error",
					{
						"allowAny": false,
						"allowBoolean": false,
						"allowNullish": false,
						"allowNumberAndString": false,
						"allowRegExp": false
					}
				],
				"typescript/return-await": ["error", "error-handling-correctness-only"],
				"typescript/triple-slash-reference": "error",
				"typescript/unbound-method": "error",
				"typescript/unified-signatures": "error",
				"typescript/use-unknown-in-catch-callback-variable": "error",
				"no-void": "off"
			}
		},
		{
			// DSH plugin API boundary, deliberately wider than the upstream default.
			// The plugin surface is `any`-typed on purpose: the Cordis/DSH plugin
			// event payloads are polymorphic and ctx/bot handles come from ambient
			// declarations (types/plugin.d.ts) with the compiler loosened
			// accordingly (strict: false, noImplicitAny: false). Enforcing
			// no-explicit-any / no-unsafe-* here would force re-typing the whole
			// DSH event contract, so this repo deviates from the upstream ruleset
			// exactly on those boundary rules and keeps everything else strict.
			"files": ["src/**/*.{ts,tsx}"],
			"plugins": ["typescript"],
			"rules": {
				"typescript/no-explicit-any": "off",
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-declaration-merging": "off",
				"typescript/no-unsafe-enum-comparison": "off",
				"typescript/no-unsafe-function-type": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off",
				"typescript/no-unsafe-unary-minus": "off"
			}
		},
		{
			// Type-level spelling consistency. The same type written two ways
			// (`T[]` vs `Array<T>`, `interface` vs `type`, `Record<K, V>` vs
			// `{ [k: K]: V }`, `{ (): void }` vs `() => void`) is a purely
			// cosmetic diff that still collides with real changes on merge,
			// and it silently spreads via copy-paste.
			"files": ["src/**/*.{ts,tsx}"],
			"plugins": ["typescript"],
			"rules": {
				"typescript/array-type": ["warn", { "default": "array-simple" }],
				"typescript/consistent-type-definitions": ["warn", "interface"],
				"typescript/consistent-indexed-object-style": ["warn", "record"],
				"typescript/consistent-type-assertions": ["warn", { "assertionStyle": "as" }],
				"typescript/prefer-function-type": "warn",
				// Overloads that drift apart are edited in two places; keeping
				// them adjacent keeps the change single-hunk.
				"typescript/adjacent-overload-signatures": "warn"
			}
		},
		{
			// Size limits are nudges for source, not for tests: specs are
			// legitimately long (fixtures, per-case describes) and splitting
			// them on line count would only add churn.
			"files": ["**/*.{test,spec}.{ts,tsx}", "**/__tests__/**/*.{ts,tsx}"],
			"rules": {
				"max-lines": "off",
				"max-lines-per-function": "off",
				"max-statements": "off",
				"max-depth": "off",
				"complexity": "off",
				"max-classes-per-file": "off"
			}
		}
	]
}
